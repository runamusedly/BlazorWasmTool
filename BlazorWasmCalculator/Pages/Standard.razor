@page "/"
@inject CalculatorState Calc

<PageTitle>@Layout?.standard</PageTitle>

@*디스플레이창*@
<div class="calculator-display">
	@if (Calc.IsShowingWarning)
	{
		<div>
			<textarea class="warning" readonly>@Calc.WarningMessage</textarea>
		</div>
	}
	else
	{
		<div>
			<textarea class="warning" readonly></textarea>
		</div>
	}

	@if (!Calc.IsShowingResult)
	{
		<div>
			<textarea class="display-input @GetDisplayClass()" readonly>@FormatNumber(Calc.CurrentInput)</textarea>
		</div>

	}
	else
	{
		<div>
			<textarea class="display-result @GetDisplayClass()" readonly>@FormatNumber(Calc.CurrentInput)</textarea> @*결과값의 모양을 특화하기 위함*@
		</div>
	}
	<div>
		<textarea class="display-process @GetProcessClass()" readonly>@Calc.ProcessCalc</textarea>
	</div>
</div>

@*버튼부*@
<div class="calculator-body">
	<button class="calculator-button-operator">&percnt;</button>@* % *@
	<button class="calculator-button-clear" @onclick="Clear">
		<span class="material-icons">
			delete_forever
		</span>
	</button>
	<button class="calculator-button-clear" @onclick="Backspace">
		<span class="material-icons">
			backspace
		</span>
	</button>
	<button class="calculator-button-operator" @onclick="InputOpDivide">&divide;</button>@* / *@
	<button class="calculator-button-number" @onclick="InputNum7">&#120829;</button>@* 7 *@
	<button class="calculator-button-number" @onclick="InputNum8">&#120830;</button>@* 8 *@
	<button class="calculator-button-number" @onclick="InputNum9">&#120831;</button>@* 9 *@
	<button class="calculator-button-operator" @onclick="InputOpMultiply">&times;</button>@* * *@
	<button class="calculator-button-number" @onclick="InputNum4">&#120826;</button>@* 4 *@
	<button class="calculator-button-number" @onclick="InputNum5">&#120827;</button>@* 5 *@
	<button class="calculator-button-number" @onclick="InputNum6">&#120828;</button>@* 6 *@
	<button class="calculator-button-operator" @onclick="InputOpMinus">&minus;</button>@* - *@
	<button class="calculator-button-number" @onclick="InputNum1">&#120823;</button>@* 1 *@
	<button class="calculator-button-number" @onclick="InputNum2">&#120824;</button>@* 2 *@
	<button class="calculator-button-number" @onclick="InputNum3">&#120825;</button>@* 3 *@
	<button class="calculator-button-operator" @onclick="InputOpPlus">&plus;</button>@* + *@
	<button class="calculator-button-number" @onclick="InputNum00">&#120822;&#120822;</button>@* 00*@
	<button class="calculator-button-number" @onclick="InputNum0">&#120822;</button>@* 0 *@
	<button class="calculator-button-operator" @onclick="InputDecimal">&#8729;</button>@* . *@
	<button class="calculator-button-operator" @onclick="Calculate">&equals;</button>@* = *@
</div>

@code {
	[CascadingParameter]
	public MainLayout? Layout { get; set; }

	protected override void OnInitialized()
	{
		Layout?.SetTitle(Layout.standard);
	}

	const int MaxDigits = 15;
	const string LengthMessage = "입력 가능한 숫자는 15자리입니다.";
	const string DivideMessage = "0으로 나눌 수 없습니다.";

	//숫자버튼입력
	void InputNum(string num)
	{
		Calc.IsShowingWarning = false;

		if (Calc.ProcessCalc is null)
		{
			if (!(Calc.CurrentInput.Contains(".")))
			{
				if (!(Calc.CurrentInput.Length > (MaxDigits - 1)))
				{
					Calc.CurrentInput += num;
				}
				else
				{
					Calc.IsShowingWarning = true;
					Calc.WarningMessage = LengthMessage;
				}
			}
			else
			{
				if (!(Calc.CurrentInput.Length > MaxDigits))
				{
					Calc.CurrentInput += num;
				}
				else
				{
					Calc.IsShowingWarning = true;
					Calc.WarningMessage = LengthMessage;
				}
			}
		}
		else
		{
			if (!(Calc.ProcessCalc.Contains("=")))
			{
				if (!(Calc.CurrentInput.Contains(".")))
				{
					if (!(Calc.CurrentInput.Length > (MaxDigits - 1)))
					{
						Calc.CurrentInput += num;
					}
					else
					{
						Calc.IsShowingWarning = true;
						Calc.WarningMessage = LengthMessage;
					}
				}
				else
				{
					if (!(Calc.CurrentInput.Length > MaxDigits))
					{
						Calc.CurrentInput += num;
					}
					else
					{
						Calc.IsShowingWarning = true;
						Calc.WarningMessage = LengthMessage;
					}
				}
			}
			else
			{
			}
		}
	}

	void InputNum00()
	{
		InputNum("00");
	}

	void InputNum0()
	{
		InputNum("0");
	}

	void InputNum1()
	{
		InputNum("1");
	}

	void InputNum2()
	{
		InputNum("2");
	}

	void InputNum3()
	{
		InputNum("3");
	}

	void InputNum4()
	{
		InputNum("4");
	}

	void InputNum5()
	{
		InputNum("5");
	}

	void InputNum6()
	{
		InputNum("6");
	}

	void InputNum7()
	{
		InputNum("7");
	}

	void InputNum8()
	{
		InputNum("8");
	}

	void InputNum9()
	{
		InputNum("9");
	}


	//연산자입력
	void InputOp(string op)
	{
		Calc.IsShowingWarning = false;
		string s = Calc.CurrentInput;
		bool success = double.TryParse(s, out double num);

		if (Calc.ProcessCalc is null)
		{
			if (success)
			{
				Calc.PreviousValue = double.Parse(Calc.CurrentInput);
				Calc.Operator = op;
				Calc.ProcessCalc = FormatNumber(Calc.CurrentInput) + " " + op + " ";
				Calc.CurrentInput = "";
			}
			else
			{

			}

		}
		else
		{
			if (Calc.ProcessCalc.Contains("="))
			{
				Calc.IsShowingResult = false;
				Calc.Operator = op;
				Calc.ProcessCalc = Calc.Result.ToString("#,##0.############") + " " + op + " ";
				Calc.CurrentInput = "";
			}
			else
			{
				if (success)
				{
					double current = double.Parse(Calc.CurrentInput);
					string? previousOp = Calc.Operator;
					if (previousOp is null)
					{
						return;
					}

					switch (previousOp)
					{
						case "+":
							Calc.PreviousValue = Calc.PreviousValue + current;
							break;
						case "-":
							Calc.PreviousValue = Calc.PreviousValue - current;
							break;
						case "\u00F7": //Unicode
							if (current == 0)
							{
								Calc.IsShowingWarning = true;
								Calc.WarningMessage = DivideMessage;
								Calc.CurrentInput = "";
								Calc.PreviousValue = 0;
								Calc.Operator = null;
								Calc.Result = 0;
								Calc.ProcessCalc = null;

								return;
							}

							Calc.PreviousValue = Calc.PreviousValue / current;
							break;
						case "\u00D7":
							Calc.PreviousValue = Calc.PreviousValue * current;
							break;
					}

					Calc.Operator = op;
					Calc.ProcessCalc = Calc.ProcessCalc + FormatNumber(Calc.CurrentInput) + " " + op + " ";
					Calc.CurrentInput = "";
				}
				else
				{

				}

			}
		}

	}

	void InputOpPlus()
	{
		InputOp("+");
	}

	void InputOpDivide()
	{
		InputOp("\u00F7");
	}

	void InputOpMinus()
	{
		InputOp("-");
	}

	void InputOpMultiply()
	{
		InputOp("\u00D7");
	}

	//소수점입력
	void InputDecimal()
	{
		if (!(Calc.CurrentInput.Contains(".")))
		{
			if (Calc.CurrentInput == "")
			{
				Calc.CurrentInput = "0.";
			}
			else
			{
				Calc.CurrentInput += ".";
			}
		}
		else
		{

		}	
	}

	//등호입력
	void Calculate()
	{
		Calc.IsShowingWarning = false;


		if (Calc.ProcessCalc is null)
		{
			Calc.IsShowingResult = false;
			return;
		}
		else
		{
			//string processCalc = Calc.ProcessCalc.TrimEnd();
			//string s = processCalc;
			//char c = s[s.Length - 1];
			//string processCalcEndPart = c.ToString();
			//bool success = double.TryParse(processCalcEndPart, out double num);

			string s = Calc.CurrentInput;
			bool success = double.TryParse(s, out double num);

			if (Calc.ProcessCalc.Contains("="))
			{
				Calc.IsShowingResult = true;
				return;
			}
			else
			{
				if (success)
				{
					Calc.IsShowingResult = true;
					Calc.ProcessCalc += FormatNumber(Calc.CurrentInput);
					Calc.ProcessCalc += " =";
					double current = double.Parse(Calc.CurrentInput);

					switch (Calc.Operator)
					{
						case "+":
							Calc.PreviousValue = Calc.PreviousValue + current;
							break;
						case "-":
							Calc.PreviousValue = Calc.PreviousValue - current;
							break;
						case "\u00F7": //Unicode
							if (current == 0)
							{
								Calc.IsShowingWarning = true;
								Calc.IsShowingResult = false;
								Calc.WarningMessage = DivideMessage;
								Calc.CurrentInput = "";
								Calc.PreviousValue = 0;
								Calc.Operator = null;
								Calc.Result = 0;
								Calc.ProcessCalc = null;

								return;
							}

							Calc.PreviousValue = Calc.PreviousValue / current;
							break;
						case "\u00D7":
							Calc.PreviousValue = Calc.PreviousValue * current;
							break;
					}
					Calc.Result = Calc.PreviousValue;
					Calc.CurrentInput = Calc.Result.ToString();
					Calc.Operator = null;
				}
				else
				{

				}

			}
		}

	}

	//전체삭제
	void Clear()
	{
		Calc.IsShowingWarning = false;
		Calc.IsShowingResult = false;
		Calc.CurrentInput = "";
		Calc.PreviousValue = 0;
		Calc.Operator = null;
		Calc.Result = 0;
		Calc.ProcessCalc = null;

	}

	//하나씩 지우기
	void Backspace() //0.에서 백스페이스를 사용하면 0이 남는다. 이때 03같은 의도치않은 상황이 발생한다
	{
		Calc.IsShowingWarning = false;
		Calc.IsShowingResult = false;

		if (Calc.CurrentInput.Length <= 1)
		{
			Calc.CurrentInput = "";
		}
		else
		{
			Calc.CurrentInput = Calc.CurrentInput[..^1];
		}
	}

	//천단위 기호 삽입 및 숫자길이 제한
	string FormatNumber(string input)
	{
		if (input.Length == 2)
		{
			return input;
		}

		if (Calc.CurrentInput.Contains("."))
		{
			return input; //소수점이 들어간 숫자는 천단위 기호를 삽입할 수 없음

		}
		else
		{
			if (double.TryParse(input, out double value))
			{
				return value.ToString("#,##0.###########");
			}
		}

		return input;


	}

	//출력문자열 길이에 따른 CSS 변경
	string GetDisplayClass()
	{
		int len = Calc.CurrentInput.Length;

		if (len <= 10)
		{
			return "display-normal";
		}

		if (len <= 20)
		{
			return "display-small";
		}

		return "display-xsmall";
	}


	//계산과정 길이에 다른 CSS 변경
	string GetProcessClass()
	{
		if (Calc.ProcessCalc is null)
		{
			return "process-normal";
		}
		else
		{
			int len = Calc.ProcessCalc.Length;
			if (len <= 20)
			{
				return "process-normal";
			}
			else if (len <= 30)
			{
				return "process-small";
			}
			else
			{
				return "process-xsmall";
			}
		}
	}

}
