@page "/"
@inject CalculatorState Calc

<PageTitle>@Layout?.standard</PageTitle>

@*디스플레이창*@
<div class="calculator-display">
	@if (Calc.ShowLimitWarning)
	{
		<div class="warning">@Calc.WarningMessage</div>
	}

	@if (Calc.IsShowingResult)
	{
		<div class="display-result @GetDisplayClass()">@Calc.Result.ToString("#,##0.############")</div>
	}
	else
	{
		<div class="display-input @GetDisplayClass()">@FormatNumber(Calc.CurrentInput)</div>
	}

	<div class="display-process @GetProcessClass()">@Calc.ProcessCalc</div>
</div>

@*버튼부*@
<div class="calculator-body">
	<button class="calculator-button-operator">&percnt;</button>@* % *@
	<button class="calculator-button-clear" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="Clear">
		<span class="material-icons">
			delete_forever
		</span>
	</button>
	<button class="calculator-button-clear" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="Backspace">
		<span class="material-icons">
			backspace
		</span>
	</button>
	<button class="calculator-button-operator" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputOpDivide">&divide;</button>@* / *@
	<button class="calculator-button-number" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputNum7">&#120829;</button>@* 7 *@
	<button class="calculator-button-number" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputNum8">&#120830;</button>@* 8 *@
	<button class="calculator-button-number" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputNum9">&#120831;</button>@* 9 *@
	<button class="calculator-button-operator" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputOpMultiply">&times;</button>@* * *@
	<button class="calculator-button-number" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputNum4">&#120826;</button>@* 4 *@
	<button class="calculator-button-number" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputNum5">&#120827;</button>@* 5 *@
	<button class="calculator-button-number" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputNum6">&#120828;</button>@* 6 *@
	<button class="calculator-button-operator" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputOpMinus">&minus;</button>@* - *@
	<button class="calculator-button-number" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputNum1">&#120823;</button>@* 1 *@
	<button class="calculator-button-number" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputNum2">&#120824;</button>@* 2 *@
	<button class="calculator-button-number" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputNum3">&#120825;</button>@* 3 *@
	<button class="calculator-button-operator" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputOpPlus">&plus;</button>@* + *@
	<button class="calculator-button-number" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputNum00">&#120822;&#120822;</button>@* 00*@
	<button class="calculator-button-number" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputNum0">&#120822;</button>@* 0 *@
	<button class="calculator-button-operator" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="InputDecimal">&#8729;</button>@* . *@
	<button class="calculator-button-operator" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="Calculate">&equals;</button>@* = *@
</div>

@code {
	[CascadingParameter]
	public MainLayout? Layout { get; set; }

	protected override void OnInitialized()
	{
		Layout?.SetTitle(Layout.standard);
	}

	const int MaxDigits = 12;
	const string LengthMessage = "입력 가능한 숫자는 12자리입니다.";
	const string DivideMessage = "0으로 나눌 수 없습니다.";

	//숫자버튼입력
	void InputNum(string num)
	{
		Calc.ShowLimitWarning = false;

		if ((Calc.CurrentInput == "0") && (Calc.ProcessCalc is null))
		{
			Calc.CurrentInput = num;
			return;
		}

		if (!(Calc.ProcessCalc is null))
		{
			if (Calc.ProcessCalc.Contains("="))
			{
				Calc.CurrentInput = num;
				Calc.ProcessCalc = null;
			}
			else
			{
				if (Calc.CurrentInput.Contains("."))
				{
					if (Calc.CurrentInput.Length > MaxDigits)
					{
						Calc.ShowLimitWarning = true;
						Calc.WarningMessage = LengthMessage;
						return;
					}

					Calc.CurrentInput += num;
				}
				else
				{
					if (Calc.CurrentInput.Length > (MaxDigits - 1))
					{
						Calc.ShowLimitWarning = true;
						Calc.WarningMessage = LengthMessage;
						return;
					}

					if (Calc.CurrentInput == "0")
					{
						Calc.CurrentInput = num;
					}
					else
					{
						Calc.CurrentInput += num;
					}
				}
			}
		}
		else
		{
			if (Calc.CurrentInput.Contains("."))
			{
				if (Calc.CurrentInput.Length > MaxDigits)
				{
					Calc.ShowLimitWarning = true;
					Calc.WarningMessage = LengthMessage;
					return;
				}

				Calc.CurrentInput += num;
			}
			else
			{
				if (Calc.CurrentInput.Length > (MaxDigits - 1))
				{
					Calc.ShowLimitWarning = true;
					Calc.WarningMessage = LengthMessage;
					return;
				}

				Calc.CurrentInput += num;
			}
		}
	}

	void InputNum00()
	{
		Calc.IsShowingResult = false;
		InputNum("00");
	}

	void InputNum0()
	{
		Calc.IsShowingResult = false;
		InputNum("0");
	}

	void InputNum1()
	{
		Calc.IsShowingResult = false;
		InputNum("1");
	}

	void InputNum2()
	{
		Calc.IsShowingResult = false;
		InputNum("2");
	}

	void InputNum3()
	{
		Calc.IsShowingResult = false;
		InputNum("3");
	}

	void InputNum4()
	{
		Calc.IsShowingResult = false;
		InputNum("4");
	}

	void InputNum5()
	{
		Calc.IsShowingResult = false;
		InputNum("5");
	}

	void InputNum6()
	{
		Calc.IsShowingResult = false;
		InputNum("6");
	}

	void InputNum7()
	{
		Calc.IsShowingResult = false;
		InputNum("7");
	}

	void InputNum8()
	{
		Calc.IsShowingResult = false;
		InputNum("8");
	}

	void InputNum9()
	{
		Calc.IsShowingResult = false;
		InputNum("9");
	}


	//연산자입력
	void InputOp(string op)
	{
		if (Calc.ProcessCalc is null)
		{
			Calc.ShowLimitWarning = false;
			Calc.PreviousValue = double.Parse(Calc.CurrentInput);
			Calc.Operator = op;
			Calc.ProcessCalc = FormatNumber(Calc.CurrentInput) + " " + op + " ";
			Calc.CurrentInput = "0";
		}
		else
		{
			if (Calc.ProcessCalc.Contains("="))
			{
				Calc.ShowLimitWarning = false;
				Calc.IsShowingResult = false;
				Calc.Operator = op;
				Calc.ProcessCalc = Calc.Result.ToString("#,##0.############") + " " + op + " ";
				Calc.CurrentInput = "0";
			}
			else
			{
				Calc.ShowLimitWarning = false;
				double current = double.Parse(Calc.CurrentInput);
				string? previousOp = Calc.Operator;
				if (previousOp is null)
				{
					return;
				}

				switch (previousOp)
				{
					case "+":
						Calc.PreviousValue = Calc.PreviousValue + current;
						break;
					case "-":
						Calc.PreviousValue = Calc.PreviousValue - current;
						break;
					case "\u00F7":
						if (current == 0)
						{
							Calc.ShowLimitWarning = true;
							Calc.WarningMessage = DivideMessage;
							Calc.CurrentInput = "0";
							Calc.PreviousValue = 0;
							Calc.Operator = null;
							Calc.Result = 0;
							Calc.ProcessCalc = null;

							return;
						}

						Calc.PreviousValue = Calc.PreviousValue / current;
						break;
					case "\u00D7":
						Calc.PreviousValue = Calc.PreviousValue * current;
						break;
				}

				Calc.Operator = op;
				Calc.ProcessCalc = Calc.PreviousValue.ToString("#,##0.############") + " " + op + " ";
				Calc.CurrentInput = "0";
			}
		}

	}

	void InputOpPlus()
	{
		InputOp("+");
	}

	void InputOpDivide()
	{
		InputOp("\u00F7");
	}

	void InputOpMinus()
	{
		InputOp("-");
	}

	void InputOpMultiply()
	{
		InputOp("\u00D7");
	}

	//소수점입력
	void InputDecimal()
	{
		if (Calc.CurrentInput.Contains("."))
		{
			return;
		}

		if (Calc.CurrentInput == "0")
		{
			Calc.CurrentInput = "0.";
		}
		else
		{
			Calc.CurrentInput += ".";
		}
	}

	//등호입력
	void Calculate()
	{
		if (Calc.ProcessCalc is null)
		{
			Calc.IsShowingResult = false;
			return;
		}
		else
		{
			if (Calc.ProcessCalc.Contains("="))
			{
				Calc.IsShowingResult = true;
				return;
			}
			else
			{
				Calc.ShowLimitWarning = false;
				Calc.IsShowingResult = true;
				Calc.ProcessCalc += FormatNumber(Calc.CurrentInput);
				Calc.ProcessCalc += " =";
				double current = double.Parse(Calc.CurrentInput);

				switch (Calc.Operator)
				{
					case "+":
						Calc.PreviousValue = Calc.PreviousValue + current;
						break;
					case "-":
						Calc.PreviousValue = Calc.PreviousValue - current;
						break;
					case "\u00F7": //Unicode
						if (current == 0)
						{
							Calc.ShowLimitWarning = true;
							Calc.WarningMessage = DivideMessage;
							Calc.IsShowingResult = false;
							Calc.CurrentInput = "0";
							Calc.PreviousValue = 0;
							Calc.Operator = null;
							Calc.Result = 0;
							Calc.ProcessCalc = null;

							return;
						}

						Calc.PreviousValue = Calc.PreviousValue / current;
						break;
					case "\u00D7":
						Calc.PreviousValue = Calc.PreviousValue * current;
						break;
				}
				Calc.Result = Calc.PreviousValue;
				Calc.CurrentInput = Calc.Result.ToString();
				Calc.Operator = null;
			}
		}

	}

	//전체삭제
	void Clear()
	{
		Calc.IsShowingResult = false;
		Calc.CurrentInput = "0";
		Calc.PreviousValue = 0;
		Calc.Operator = null;
		Calc.Result = 0;
		Calc.ProcessCalc = null;
		Calc.ShowLimitWarning = false;
	}

	//하나씩 지우기
	void Backspace()
	{
		if (Calc.CurrentInput.Length <= 1)
		{
			Calc.CurrentInput = "0";
		}
		else
		{
			Calc.CurrentInput = Calc.CurrentInput[..^1];
		}
	}

	//천단위 기호 삽입 및 숫자길이 제한
	string FormatNumber(string input)
	{
		if (input.Length == 2)
		{
			return input;
		}

		if (Calc.CurrentInput.Contains("."))
		{
			return input;
		}
		else
		{
			if (double.TryParse(input, out double value))
			{
				return value.ToString("#,##0.###########");
			}
		}

		return input;


	}

	//출력문자열 길이에 따른 CSS 변경
	string GetDisplayClass()
	{
		int len = Calc.CurrentInput.Length;

		if (len <= 13)
		{
			return "display-normal";
		}

		if (len <= 20)
		{
			return "display-small";
		}

		return "display-xsmall";
	}


	//계산과정 길이에 다른 CSS 변경
	string GetProcessClass()
	{
		if (Calc.ProcessCalc is null)
		{
			return "process-normal";
		}
		else
		{
			int len = Calc.ProcessCalc.Length;
			if (len <= 20)
			{
				return "process-normal";
			}
			else
			{
				return "process-small";
			}
		}
	}

}
